# Todas as variáveis são OPCIONAIS. O app funciona sem nenhuma chave.

# --- Notícias (fontes extras, opcionais) ---
# Chave do GNews (https://gnews.io). Se definida, as rotas de notícias podem usá-la como fonte adicional.
GNEWS_API_KEY=
# Chave do NewsAPI (https://newsapi.org). Mesma lógica.
NEWSAPI_KEY=

# --- Rede corporativa ---
# Se sua rede faz inspeção TLS (proxy corporativo) e o Node falha com
# "certificate signature failure" / "self signed certificate in chain",
# aponte para um PEM com a cadeia de certificados do proxy.
# O script scripts/dev.mjs lê este valor de .env.local antes de iniciar o Next.
NODE_EXTRA_CA_CERTS=

# URL pública do site (usada nos metadados Open Graph de /pais/[code]).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
